						"description": "Recupera la información del usuario autenticado a partir del token JWT enviado en las cabeceras."
					},
					"response": []
				}
			]
		},
		{
			"name": "Lista de Espera",
			"item": [
				{
					"name": "Obtener Listas de Espera",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/waitlist",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"waitlist"
							]
						},
						"description": "Obtiene los registros de las listas de espera. Si el usuario es Paciente, retorna solo sus solicitudes. Si es Funcionario (Admin), retorna todas las listas de espera con búsqueda y filtros."
					},
					"response": []
				},
				{
					"name": "Agregar a Lista de Espera",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"especialidad\": \"Cardiología\",\n    \"centro_id\": \"hc1\",\n    \"prioridad\": \"normal\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/waitlist",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"waitlist"
							]
						},
						"description": "Ingresa una nueva solicitud de interconsulta a la lista de espera para el paciente autenticado. Calcula automáticamente la posición."
					},
					"response": []
				},
				{
					"name": "Modificar Registro (Solo Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"prioridad\": \"alta\",\n    \"estado\": \"programada\",\n    \"centro_id\": \"hc1\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/waitlist/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"waitlist",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "id-del-registro-waitlist",
									"description": "ID único de la entrada en la lista de espera (UUID)"
								}
							]
						},
						"description": "Permite a un funcionario de salud actualizar los parámetros de un registro (prioridad, estado, centro de derivación) en la lista de espera."
					},
					"response": []
				},
				{
					"name": "Eliminar Registro (Solo Admin)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/waitlist/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"waitlist",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "id-del-registro-waitlist",
									"description": "ID de la entrada a eliminar"
								}
							]
						},
						"description": "Permite a un funcionario administrativo del SOME remover de forma permanente un registro de la lista de espera."
					},
					"response": []
				}
			]
		},
