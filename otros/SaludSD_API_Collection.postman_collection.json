							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/claveunica/callback",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"claveunica",
								"callback"
							]
						},
						"description": "Simula el intercambio seguro de código del flujo OIDC de ClaveÚnica para un funcionario de prueba (Dr. Carlos Muñoz). Retorna un token JWT con rol administrativo."
					},
					"response": []
				},
				{
					"name": "Obtener Perfil Actual (/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": [
