{
	"info": {
		"_postman_id": "8b5f3a02-d961-460b-8012-a7d517c5b61a",
		"name": "SaludSD API",
		"description": "Colección de peticiones HTTP para probar la API RESTful de la plataforma de gestión de listas de espera SaludSD (Municipalidad de Santo Domingo). Incluye flujos de autenticación local, callback de ClaveÚnica y endpoints CRUD protegidos por JWT.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Registro Local (Paciente)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Juan Martínez López\",\n    \"rut\": \"15.678.234-3\",\n    \"email\": \"juan.martinez@email.com\",\n    \"password\": \"123456\",\n    \"region\": \"Valparaíso\",\n    \"comuna\": \"Santo Domingo\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registra un nuevo paciente localmente en el sistema. Valida duplicidad de RUT e email, encripta la contraseña usando bcrypt y retorna el token JWT firmado."
					},
					"response": []
				},
				{
					"name": "Inicio de Sesión Local",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"rut\": \"12.345.678-5\",\n    \"password\": \"123456\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica a un usuario (paciente o funcionario) utilizando su RUT y contraseña local. Si las credenciales coinciden, genera y retorna el token JWT firmado. El script de pruebas almacena automáticamente este token en la variable {{jwt_token}}."
					},
					"response": []
				},
				{
					"name": "Callback ClaveÚnica (Simulación Paciente)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"mock_patient_code\",\n    \"state\": \"mock_patient_state\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth/claveunica/callback",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"claveunica",
								"callback"
							]
						},
						"description": "Simula el intercambio seguro de código del flujo OIDC de ClaveÚnica para un paciente de prueba (María González). Retorna un token JWT válido."
					},
					"response": []
				},
				{
					"name": "Callback ClaveÚnica (Simulación Funcionario)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
